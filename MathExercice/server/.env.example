# ── Database ──────────────────────────────────────────────────────
# PostgreSQL connection string (used by default)
DATABASE_URL=postgresql://mathuser:mathpass@localhost:5432/mathpractice

# Set to "sqlite" to use SQLite as a dev fallback (file: ./dev.db)
# DB_DRIVER=sqlite

# ── Server ────────────────────────────────────────────────────────
PORT=3001

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
