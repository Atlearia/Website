{
  "name": "ningye-api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "npm run migrate && node dist/index.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:ip-hash": "tsx src/migrations/002-ip-hash.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.1.0",
    "pg": "^8.13.0",
    "uuid": "^10.0.0",
    "@types/cors": "^2.8.17",
    "@types/node": "^22.0.0",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.6.2"
  },
  "devDependencies": {
    "vitest": "^2.1.8"
  }
}
